# Copy this file to .env and fill in your real values (VM mode only).
# .env is git-ignored — your secrets never leave your VM.
DHAN_TOKEN=paste-your-dhan-access-token-here
TELEGRAM_BOT_TOKEN=paste-bot-token-here
TELEGRAM_CHAT_ID=paste-chat-id-here
# Optional second M6 bot (mirrors every M6 alert + EOD report). Leave both blank
# to keep single-chat delivery; the pair is skipped unless token AND chat are set.
M6_BOT_TOKEN_2=
M6_CHAT_ID_2=
