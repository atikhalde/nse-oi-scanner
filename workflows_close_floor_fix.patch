diff --git a/.github/workflows/2_bootstrap.yml b/.github/workflows/2_bootstrap.yml
index 8eb569c..5a44d56 100644
--- a/.github/workflows/2_bootstrap.yml
+++ b/.github/workflows/2_bootstrap.yml
@@ -29,29 +29,57 @@ jobs:
       - run: pip install -r requirements.txt
       - run: python -u live_runner.py --bootstrap refresh-60d
       - run: python -u m9_bootstrap.py || echo "m9 bootstrap failed (non-fatal)"   # M9 cash data-farm history9 (~1,050 syms)
-      - run: python -u label_learn.py   # Phase-0 Learning Log labeler (ML dataset build-up)
-      - name: commit data safely against moving main
+      - name: commit refreshed history immediately
+        # The history MUST land on main before anything slow runs: every
+        # M12/M13/M14 prev-close baseline reads these files, and when this
+        # commit waited behind label_learn.py the 55-min job timeout cancelled
+        # it for 8 straight days — history froze at 2026-08-18 and all three
+        # models sat in strict no-entry the next session.
         run: |
           set -euo pipefail
           git config user.name "paper-bot"
           git config user.email "paper-bot@users.noreply.github.com"
-          git add data/ learn/
+          git add data/
           if git diff --cached --quiet; then
             echo "nothing to commit"
             exit 0
           fi
           git commit -m "bootstrap $(date -u +%F_%H%M)Z"
-
-          # Live paper workflows may advance main while the 20–30 minute data
-          # refresh is running. Rebase and retry instead of losing the refresh.
           for attempt in 1 2 3 4 5 6; do
             echo "bootstrap push attempt ${attempt}/6"
             git pull --rebase origin main
             if git push origin HEAD:main; then
-              echo "bootstrap data committed successfully"
+              echo "bootstrap history committed successfully"
               exit 0
             fi
             sleep $((attempt * 5))
           done
           echo "bootstrap push failed after 6 rebased attempts" >&2
           exit 1
+      - name: learning-log labels (time-boxed, non-fatal)
+        # Slow learner runs AFTER the history is safely committed. It can be
+        # cancelled without ever taking the refreshed data down with it.
+        run: |
+          timeout 30m python -u label_learn.py || echo "label_learn incomplete (non-fatal)"
+      - name: commit learn/ best-effort
+        run: |
+          set -euo pipefail
+          git config user.name "paper-bot"
+          git config user.email "paper-bot@users.noreply.github.com"
+          git add learn/ || true
+          if git diff --cached --quiet; then
+            echo "nothing to commit"
+            exit 0
+          fi
+          git commit -m "learnlog $(date -u +%F_%H%M)Z"
+          for attempt in 1 2 3 4 5 6; do
+            echo "learn push attempt ${attempt}/6"
+            git pull --rebase origin main
+            if git push origin HEAD:main; then
+              echo "learn data committed successfully"
+              exit 0
+            fi
+            sleep $((attempt * 5))
+          done
+          echo "learn push failed after 6 attempts (non-fatal)" >&2
+          exit 0
