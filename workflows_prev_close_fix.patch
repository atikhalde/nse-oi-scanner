+      # --- Stage 1 (critical): the 210-symbol history every model reads.
+      # M12/M13/M14 previous-close gates and every engine ATR/EMA warmup come
+      # from these files. Must commit before the slow stages run.
+      - name: Refresh 60d history (210 F&O symbols)
+        run: python -u live_runner.py --bootstrap refresh-60d
+      - name: Commit history refresh
+        run: bash bootstrap_commit.sh "bootstrap history $(date -u +%F_%H%M)Z"
+
+      # --- Stage 2 (optional): M9 cash data-farm history (~1,050 symbols).
+      # Non-fatal and on its own timeout: it must never be able to cancel the
+      # run before stage 1 has been committed.
+      - name: M9 cash history (~1050 symbols, optional)
+        continue-on-error: true
+        timeout-minutes: 60
+        run: python -u m9_bootstrap.py
+      - name: Commit M9 history
+        continue-on-error: true
+        run: bash bootstrap_commit.sh "bootstrap m9 $(date -u +%F_%H%M)Z"
+
+      # --- Stage 3 (optional): Phase-0 learning-log labels.
+      - name: Label newest session
