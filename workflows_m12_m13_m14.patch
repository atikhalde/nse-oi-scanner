diff --git a/.github/workflows/14_live_m14.yml b/.github/workflows/14_live_m14.yml
new file mode 100644
index 00000000..56cc98ee
--- /dev/null
+++ b/.github/workflows/14_live_m14.yml
@@ -0,0 +1,85 @@
+name: "14. LIVE M14 — ultra high-conviction A+ (max 3/day, paper-only)"
+
+on:
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: "'live' = normal cycle · 'test-alert' = send M14 to all 3 targets · 'reseed' = rebuild prev-close cache only"
+        required: true
+        default: "live"
+  schedule:
+    # Five-minute paper ticker: 09:15–15:30 IST (03:45–10:00 UTC), weekdays.
+    - cron: "45-59/5 3 * * 1-5"
+    - cron: "*/5 4-9 * * 1-5"
+    - cron: "0,5 10 * * 1-5"
+    # 16:10 IST post-close: rebuild tomorrow's prev-close cache from finalised
+    # daily data. Covers the case where Yahoo lagged the 15:25 EOD cycle and
+    # the in-runner seed could not reach 180 symbols.
+    - cron: "40 10 * * 1-5"
+
+permissions:
+  contents: write
+
+concurrency:
+  group: live-paper-m14
+  cancel-in-progress: false
+
+jobs:
+  live-m14:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    env:
+      DHAN_TOKEN: ${{ secrets.DHAN_TOKEN }}
+      TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
+      TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
+      # Preferred M14-specific extra targets.
+      M14_BOT_TOKEN_A: ${{ secrets.M14_BOT_TOKEN_A }}
+      M14_CHAT_ID_A: ${{ secrets.M14_CHAT_ID_A }}
+      M14_BOT_TOKEN_B: ${{ secrets.M14_BOT_TOKEN_B }}
+      M14_CHAT_ID_B: ${{ secrets.M14_CHAT_ID_B }}
+      # Fallback reuse of the established M13/M11 A/B targets.
+      M13_BOT_TOKEN_A: ${{ secrets.M13_BOT_TOKEN_A }}
+      M13_CHAT_ID_A: ${{ secrets.M13_CHAT_ID_A }}
+      M13_BOT_TOKEN_B: ${{ secrets.M13_BOT_TOKEN_B }}
+      M13_CHAT_ID_B: ${{ secrets.M13_CHAT_ID_B }}
+      M11_BOT_TOKEN_A: ${{ secrets.M11_BOT_TOKEN_A }}
+      M11_CHAT_ID_A: ${{ secrets.M11_CHAT_ID_A }}
+      M11_BOT_TOKEN_B: ${{ secrets.M11_BOT_TOKEN_B }}
+      M11_CHAT_ID_B: ${{ secrets.M11_CHAT_ID_B }}
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          ref: main
+          fetch-depth: 0
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.12"
+      - run: pip install -r requirements.txt
+      - name: M14 tests
+        if: github.event.schedule != '40 10 * * 1-5' && github.event.inputs.mode != 'reseed'
+        run: |
+          python -u test_fast_feed.py
+          python -u test_m14_entry.py
+          python -u test_m14_trader.py
+          python -u test_m14_runner.py
+          python -u test_seed_prev_context.py
+      - name: M14 three-target alert test
+        if: github.event.inputs.mode == 'test-alert'
+        run: python -u m14_runner.py --test-alert
+      - name: M14 paper cycle
+        if: github.event.inputs.mode != 'test-alert' && github.event.inputs.mode != 'reseed' && github.event.schedule != '40 10 * * 1-5'
+        run: python -u m14_runner.py --loop 1
+      - name: M14 post-close prev-close reseed
+        if: github.event.schedule == '40 10 * * 1-5' || github.event.inputs.mode == 'reseed'
+        run: python -u seed_prev_context.py --models m14
+      - name: Commit M14 state, candidate ledger, and report
+        if: always()
+        run: |
+          git config user.name "paper-bot"
+          git config user.email "paper-bot@users.noreply.github.com"
+          [ ! -e state14.json ] || git add -A -- state14.json
+          [ ! -f data/m14_prev_context.json ] || git add -- data/m14_prev_context.json
+          find learn -maxdepth 1 \( -name 'm14_candidates_*.csv' -o -name 'raw_M14_*.csv' \) -print0 | xargs -0 -r git add --
+          find . -maxdepth 1 -name 'paper_test_M14_*.xlsx' -print0 | xargs -0 -r git add --
+          git diff --cached --quiet || git commit -m "m14cycle $(date -u +%F_%H%M)Z"
+          bash workflow_safe_push.sh
